    "def __init__(self, opt):\n",
    "    super(RealESRGANModel, self).__init__(opt)\n",
    "    self.jpeger = DiffJPEG(differentiable=False).cuda()  # simulate JPEG compression artifacts\n",
    "    self.usm_sharpener = USMSharp().cuda()  # sharpen the GT images\n",
    "    self.queue_size = opt.get('queue_size', 180)\n",
    "    # BasicSR SRGANModel already initializes self.lq_queue = deque(maxlen=self.queue_size)\n",
    "    # So, no need to initialize self.lq_queue here if SRGANModel does it."
   ]
