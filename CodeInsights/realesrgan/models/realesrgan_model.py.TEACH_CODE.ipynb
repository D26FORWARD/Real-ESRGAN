    "@torch.no_grad()\n",
    "def feed_data(self, data):\n",
    "    # training data synthesis\n",
    "    if self.is_train:\n",
    "        # clear old data to free GPU memory\n",
    "        # self.lq = self.lq.to(self.device) # This line seems to be a leftover or incorrect, self.lq is defined later\n",
    "        # It's better to ensure all intermediate tensors are handled carefully or deleted if not needed.\n",
    "        # For attributes that are replaced each time, direct assignment is fine.\n",
    "        # However, for attributes that might not be present in all calls (like kernels if dataset changes),\n",
    "        # explicit deletion or ensuring they are overwritten is good practice.\n",
    "        # The original code uses del for gt_usm, kernel1, kernel2, sinc_kernel which is fine.\n",
    "        # Let's assume self.lq is handled by being overwritten.\n",
    "\n",
    "        if hasattr(self, 'gt_usm'):\n",
    "            del self.gt_usm\n",
    "        if hasattr(self, 'kernel1'):\n",
    "            del self.kernel1\n",
    "        if hasattr(self, 'kernel2'):\n",
    "            del self.kernel2\n",
    "        if hasattr(self, 'sinc_kernel'):\n",
    "            del self.sinc_kernel\n",
    "        torch.cuda.empty_cache() # More aggressive cache clearing if memory is an issue\n",
    "\n",
    "        self.gt = data['gt'].to(self.device)\n",
    "        # USM sharpen the GT images\n",
    "        if self.opt['gt_usm'] is True:\n",
    "            self.gt_usm = self.usm_sharpener(self.gt)\n",
    "        else:\n",
    "            self.gt_usm = self.gt\n",
    "        # self.gt_usm = self.gt_usm.to(self.device) # usm_sharpener already moves to device if input is on device\n",
    "\n",
    "        self.kernel1 = data['kernel1'].to(self.device)\n",
    "        self.kernel2 = data['kernel2'].to(self.device)\n",
    "        self.sinc_kernel = data['sinc_kernel'].to(self.device)\n",
    "\n",
    "        ori_h, ori_w = self.gt.size()[2:4]\n",
    "\n",
    "        # ----------------------- The first degradation process ----------------------- #\n",
    "        # blur\n",
    "        out = filter2D(self.gt_usm, self.kernel1)\n",
