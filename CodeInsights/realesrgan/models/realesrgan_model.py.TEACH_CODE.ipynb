    "def optimize_parameters(self, current_iter):\n",
    "    # optimize net_g\n",
    "    for p in self.net_d.parameters():\n",
    "        p.requires_grad = False\n",
    "\n",
    "    self.optimizer_g.zero_grad()\n",
    "    self.output = self.net_g(self.lq) # Generate HR image from LQ\n",
    "\n",
    "    l_g_total = 0\n",
    "    loss_dict = OrderedDict()\n",
    "    # pixel loss\n",
    "    if self.cri_pix: # Pixel-wise loss (e.g., L1 or L2)\n",
    "        l_g_pix = self.cri_pix(self.output, self.gt_usm) # Compare generated output with (sharpened) GT\n",
    "        l_g_total += l_g_pix\n",
    "        loss_dict['l_g_pix'] = l_g_pix\n",
    "    # perceptual loss\n",
    "    if self.cri_perceptual: # Perceptual loss (e.g., VGG-based)\n",
    "        l_g_percep, l_g_style = self.cri_perceptual(self.output, self.gt_usm)\n",
    "        if l_g_percep is not None:\n",
    "            l_g_total += l_g_percep\n",
    "            loss_dict['l_g_percep'] = l_g_percep\n",
    "        if l_g_style is not None: # Style component of perceptual loss\n",
    "            l_g_total += l_g_style\n",
    "            loss_dict['l_g_style'] = l_g_style\n",
    "    # gan loss (g part)\n",
    "    # self.output is the fake_g_pred in SRGANModel\n",
    "    fake_g_pred = self.net_d(self.output) \n",
    "    l_g_gan = self.cri_gan(fake_g_pred, True, is_disc=False) # GAN loss for generator\n",
    "    l_g_total += l_g_gan\n",
    "    loss_dict['l_g_gan'] = l_g_gan\n",
    "\n",
    "    l_g_total.backward()\n",
    "    self.optimizer_g.step()\n",
    "\n",
    "    # optimize net_d\n",
    "    for p in self.net_d.parameters():\n",
    "        p.requires_grad = True\n",
    "\n",
    "    self.optimizer_d.zero_grad()\n",
    "    # real\n",
    "    # self.gt_usm is the real_d_pred in SRGANModel\n",
    "    real_d_pred = self.net_d(self.gt_usm)\n",
    "    l_d_real = self.cri_gan(real_d_pred, True, is_disc=True) # GAN loss for real images (discriminator)\n",
    "    loss_dict['l_d_real'] = l_d_real\n",
    "    loss_dict['out_d_real'] = torch.mean(real_d_pred.detach())\n",
    "    l_d_real.backward()\n",
    "    \n",
    "    # fake\n",
    "    # Use LQ images from the queue for discriminator training\n",
    "    # This is a common practice to stabilize GAN training (experience replay)\n",
    "    if len(self.lq_queue) > 0:\n",
    "        idx = random.randrange(0, len(self.lq_queue))\n",
    "        # self.lq_queue[idx] contains LQ images synthesized in previous steps\n",
    "        # self.net_g(self.lq_queue[idx]) would generate corresponding fake HR images\n",
    "        # However, SRGANModel's typical discriminator training uses detached G output or stored fake images.\n",
    "        # The original SRGANModel.feed_data puts self.fake_h (which is self.net_g(self.lq)) into a queue self.fake_data.\n",
    "        # Then, for D training, it samples from self.fake_data.\n",
    "        # Here, self.lq_queue stores *LQ* images. If D is trained on G(LQ_from_queue), it's slightly different.\n",
    "        # The provided code snippet for feed_data adds self.lq (synthesized LQ) to self.lq_queue.\n",
    "        # For discriminator's fake input, it should be G(LQ). So, we need G(lq_from_queue).\n",
    "        # Let's assume the intention is to use G's output from a *past* LQ from the queue.\n",
    "        # This requires passing G(lq_from_queue) to D.\n",
    "        # For simplicity, and aligning with common SRGAN, D is often trained on current G's output detached.\n",
    "        # The original code for RealESRGAN might have a subtle detail here or SRGANModel handles it.\n",
    "        # If self.lq_queue stores *fake HR* images (output of G), then the logic is simpler:\n",
    "        # fake_sample_for_d = self.lq_queue[idx] \n
    "        # However, the feed_data adds self.lq (the *input* to G) to the queue.\n",
    "        # This implies that for training D, we should take an LQ from queue, pass it through G, then to D.\n",
    "        # This makes D see outputs from older versions of G as well, which can be beneficial.\n",
    "        lq_from_queue = self.lq_queue[idx]\n",
    "        with torch.no_grad(): # Important: G should not be updated based on D's training on old G's output\n",
    "             fake_output_from_queued_lq = self.net_g(lq_from_queue)\n",
    "        fake_d_pred = self.net_d(fake_output_from_queued_lq.detach()) # detach again just to be safe\n",
    "    else:\n",
    "        # Fallback if queue is empty (e.g. at the very beginning of training)\n",
    "        fake_d_pred = self.net_d(self.output.detach()) # Use current generator's output, detached\n",
    "\n",
    "    l_d_fake = self.cri_gan(fake_d_pred, False, is_disc=True) # GAN loss for fake images (discriminator)\n",
    "    loss_dict['l_d_fake'] = l_d_fake\n",
    "    loss_dict['out_d_fake'] = torch.mean(fake_d_pred.detach())\n",
    "    l_d_fake.backward()\n",
    "    self.optimizer_d.step()\n",
    "\n",
    "    self.log_dict = self.reduce_loss_dict(loss_dict) # For logging (e.g. in distributed training)\n",
    "\n",
    "    if self.ema_decay > 0:\n",
    "        self.model_ema(decay=self.ema_decay) # Exponential Moving Average for model weights"
