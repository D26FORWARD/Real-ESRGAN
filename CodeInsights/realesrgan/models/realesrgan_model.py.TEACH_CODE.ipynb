    "def nondist_validation(self, dataloader, current_iter, tb_logger, save_img):\n",
    "    # This method is inherited from SRGANModel / BaseModel and is likely called for validation.\n",
    "    # It would typically iterate through the dataloader, call self.feed_data, then self.test.\n",
    "    # Then it calculates metrics (PSNR, SSIM) between self.output and self.gt.\n",
    "    # RealESRGANModel might override it to use self.gt_usm for metrics if that's the true target.\n",
    "    \n    # In Real-ESRGAN, the GT for loss calculation is self.gt_usm (if enabled).\n",
    "    # For validation metrics, it's common to compare against the original, non-sharpened GT.\n",
    "    # However, if consistency with training is desired, one might compare against gt_usm.\n",
    "    # The parent SRGANModel's nondist_validation uses self.gt for metrics.\n",
    "    # If gt_usm is consistently prepared in feed_data for validation (as shown in the updated feed_data),\n",
    "    # then we might want to ensure metrics are calculated against the correct GT version.\n",
    "\n",
    "    # Option 1: If SRGANModel's validation uses self.gt and that's desired:\n",
    "    # super(RealESRGANModel, self).nondist_validation(dataloader, current_iter, tb_logger, save_img)\n",
    "    \n    # Option 2: If metrics should be against self.gt_usm (the training target)\n",
    "    # This would require overriding more of the validation logic or ensuring SRGANModel can use self.gt_usm.\n",
    "    # For this TEACH_CODE, we'll assume the SRGANModel's default (comparing with self.gt) is acceptable,\n",
    "    # or that self.gt_usm is made available as self.gt in feed_data during validation if needed.\n",
    "    # The updated feed_data uses self.gt_usm = self.gt if val_gt_usm is False (default).\n",
    "    # So, self.gt_usm will be the original GT in validation unless val_gt_usm is True.\n",
    "    # And SRGANModel's validation by default compares self.output with self.gt.\n",
    "    # To ensure metrics are against what gt_usm was in feed_data:\n",
    "    dataset_name = dataloader.dataset.opt['name']\n",
    "    with_metrics = (self.opt['val']['metrics'] is not None)\n",
    "    use_pbar = self.opt['val'].get('pbar', False)\n",
    "\n",
    "    if with_metrics:\n",
    "        if not hasattr(self, 'metric_results'):  # only execute in the first run\n",
    "            self.metric_results = {metric: 0 for metric in self.opt['val']['metrics'].keys()}\n",
    "        # initialize the best metric results for each dataset_name (supporting multiple validation datasets)\n",
    "        self._initialize_best_metric_results(dataset_name)\n",
    "    # zero self.metric_results\n",
    "    # We use a new dict to record a specific dataset's metric results for dumping.\n",
    "    # Otherwise, the self.metric_results will be accumulated.\n",
    "    current_metric_results = {metric: 0 for metric in self.metric_results.keys()} \n",
    "\n",
    "    # For validation, ensure that gt_usm is what we want to compare against.\n",
    "    # In our feed_data, self.gt_usm is set to self.gt during validation by default.\n",
    "    # If opt['val_gt_usm'] is True, then self.gt_usm is the sharpened GT.\n",
    "    # The SRGANModel's _calculate_metrics will use self.gt. \n",
    "    # If we want to compare against self.gt_usm, we'd need to override _calculate_metrics\n",
    "    # or temporarily swap self.gt with self.gt_usm if they differ.\n",
    "    \n    # Let's proceed assuming the SRGANModel's logic will be mostly used.\n",
    "    # The key is that self.feed_data prepares self.lq and self.gt (and self.gt_usm).\n",
    "    # self.test() then generates self.output from self.lq.\n",
    "    # The parent's _calculate_metrics uses self.output and self.gt.\n",
    "    # If self.opt.get('val_gt_usm', False) is True, self.gt_usm is sharpened GT.\n",
    "    # In this case, if we want metrics against sharpened GT, we should make self.gt = self.gt_usm for validation.\n",
    "    # This is already handled in the provided feed_data logic if val_gt_usm is true, self.gt_usm is set.\n",
    "    # SRGANModel's calculate_metrics uses self.gt by default.\n",
    "    # So, if val_gt_usm is true, then feed_data sets self.gt_usm = sharpened_gt. \n",
    "    # We need to ensure that this self.gt_usm is then used as 'self.gt' for metric calculation in SRGANModel.\n",
    "    # This might mean overriding part of the validation logic.\n",
    "    # However, the simplest is to stick to SRGANModel's use of self.gt and ensure feed_data sets self.gt appropriately for validation.\n",
    "    # The provided feed_data for non-train sets self.gt_usm = self.gt (original) unless val_gt_usm = True.\n",
    "    # So, if val_gt_usm = True, self.gt_usm is sharpened, but SRGANModel will use self.gt (original).\n",
    "    # This means metrics are against original GT by default. This is standard.\n",
    "    # If metrics *must* be against sharpened GT, then SRGANModel's _calculate_metrics needs to be aware of self.gt_usm.\n",
    "\n",
    "    # Standard procedure: call super class method for validation.\n",
    "    # The SRGANModel.nondist_validation will iterate, call feed_data, test, and _calculate_metrics.\n",
    "    super(RealESRGANModel, self).nondist_validation(dataloader, current_iter, tb_logger, save_img)\n"
   ]
